# Copy to .env (repo root or backend/). Never commit .env.

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./voyagesync.db

# ── Mode ──────────────────────────────────────────────────────────────────────
# mock (default): deterministic mocks for the LLM and all external APIs — no keys, no network.
# live: real providers; any provider with a missing key logs a warning and falls back to mock.
VOYAGESYNC_MODE=mock

# ── LLM (any OpenAI-compatible chat-completions endpoint) ─────────────────────
# Examples: OpenAI https://api.openai.com/v1
#           Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#           Groq    https://api.groq.com/openai/v1
VOYAGESYNC_LLM_API_KEY=
VOYAGESYNC_LLM_MODEL=gpt-4o-mini
VOYAGESYNC_LLM_BASE_URL=https://api.openai.com/v1
VOYAGESYNC_LLM_MAX_ATTEMPTS=3

# ── External APIs (used in live mode; missing keys fall back to mock) ─────────
# Keyless: Open-Meteo (weather, geocoding), Frankfurter (FX), OSRM demo server (routing).
# Duffel test mode: create a free account at duffel.com and use a duffel_test_… token.
DUFFEL_ACCESS_TOKEN=
# Geoapify Places (hotels and attractions): free tier key from geoapify.com.
GEOAPIFY_API_KEY=
VOYAGESYNC_HTTP_TIMEOUT_S=20

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
